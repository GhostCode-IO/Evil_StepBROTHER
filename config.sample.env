# ql810wc-print-proxy — site configuration TEMPLATE (this file is committed).
#
# The normal way to create config.env is setup.sh. It copies this file, fills
# in your client network (the network of the default route, or --clients),
# --name and --snmpv3, and keeps config.env private (mode 0600, owned by root):
#
#   sudo ./setup.sh                  # write config.env if there is none, then install
#   sudo ./setup.sh --config-only    # only write config.env
#   sudo ./setup.sh --print-config   # show what it would write; change nothing
#
# By hand instead:
#   cp config.sample.env config.env && chmod 600 config.env   # config.env is gitignored
#   $EDITOR config.env                                       # replace every placeholder

# Format: KEY="value" lines only. The installer parses them; it never sources
# this file, so no shell syntax works here. Values cannot contain double
# quotes, "$(" or backticks; settings handed to the daemons (everything except
# the SNMP communities and SNMPv3 credentials) also refuse backslashes and "$".
# Yes/no settings also accept true/false, on/off and 1/0.
#
# The example addresses in config.sample.env are documentation-only ranges
# (RFC 5737 / RFC 3849) that no real network uses: setup.sh fills in your
# client network; by hand, replace them. The scripts read $QL_PROXY_CONFIG if
# it is set, else config.env in the repository root, else
# /etc/ql810wc-proxy/config.env. A setting that file leaves out keeps its
# default from config.sample.env.

# --- Network identity of this print server ----------------------------------
# IPv4 address clients use to reach this box. Empty = auto-detect the address
# of the default-route interface at install time. The firewalld zone of the
# interface holding this address receives all firewall rules.
PROXY_IP=""

# --- Data plane: raw TCP 9100 -> USB printer ----------------------------------
# TCP port of the raw (AppSocket/JetDirect) listener. P-touch Editor for Mac
# always prints to port 9100, so keep the default unless you know your clients.
RAW_PORT="9100"
# Address the listener binds. Empty = every IPv4 and IPv6 address, like a real
# printer. Set one address of this host (e.g. 192.0.2.10) to listen only there;
# the local CUPS queue then connects to that address instead of 127.0.0.1.
RAW_BIND=""
# Optional: accept TCP RAW_PORT only from these sources (space-separated CIDRs,
# IPv4 and/or IPv6). Empty = open RAW_PORT in the firewalld zone, like a real
# printer.
RAW_ALLOWED_CIDRS=""
# Relay bytes from the printer back to the network client (yes|no). Real
# network QLs never send anything on 9100; "yes" only helps clients that read
# a back-channel (some CUPS filters).
RAW_BIDIRECTIONAL="no"
# Seconds between status polls of an idle printer (1-60). The printer is never
# polled while a job is printing. The SNMP persona treats an idle status older
# than twice this (at least 60 s) as stale.
STATUS_POLL_SECONDS="3"
# Seconds a connected print client may send nothing before the proxy closes
# the connection (10-86400). A job still unfinished at that point is cancelled
# and the printer resynchronised; after a finished job it is an ordinary close
# (P-touch Editor for Mac keeps the connection open for a while after a job).
RAW_IDLE_TIMEOUT="300"
# Largest print job accepted on one connection, in bytes (65536-1073741824).
# A larger job is cancelled and the printer resynchronised. The default,
# 16777216 (16 MiB), holds an uncompressed 1 m long two-color label.
MAX_JOB_BYTES="16777216"

# --- Local CUPS queue (optional) ---------------------------------------------
# Raw queue for applications on this box. Its device is the proxy itself
# (socket://127.0.0.1:RAW_PORT), so CUPS never opens the USB printer.
# Empty = no CUPS queue. Existing queues with other names are never changed.
CUPS_QUEUE="QL810Wc-proxy"
# Share the queue on the network via CUPS/IPP (yes|no). Keep "no": a shared
# raw queue is advertised as an IPP printer and attracts PDF jobs that the QL
# cannot print. Network clients print to TCP RAW_PORT instead.
CUPS_QUEUE_SHARED="no"

# --- Printer USB identity: detected at runtime; override only if needed ------
USB_VENDOR_ID="04f9"      # Brother Industries
USB_PRODUCT_ID=""         # empty = auto-detect (QL-810W / QL-810Wc)
USB_SERIAL=""             # empty = auto-detect (first matching printer)
# Keep ipp-usb away from the printer (yes|no). ipp-usb would switch the QL to
# its IPP-over-USB mode, which disconnects the raw printer interface the proxy
# needs. "yes" adds a device-specific ipp-usb quirk; other devices are unaffected.
IPP_USB_EXCLUDE="yes"

# --- Media (informational) -----------------------------------------------------
# The persona reports the roll the printer itself reports over USB; these two
# settings are validated but not used yet (they are meant for a manual-media
# fallback, see the README's Limitations).
# brother_ql label identifier of the primary roll (DK-22251 = 62 mm continuous
# black/red two-color).
MEDIA_DEFAULT="62red"
# brother_ql identifier of a second roll you swap in, such as the die-cut
# "29x90" (DK-11201, 29 mm x 90 mm). Empty = none.
MEDIA_SECOND=""

# --- Validation tooling (optional) ---------------------------------------------
# Install brother_ql_next (pinned version) into /opt/ql810wc-proxy/venv for test
# prints from the box (yes|no). The running service never uses it. Needs
# internet access to PyPI; a failure here does not stop the install.
INSTALL_BROTHER_QL="yes"

# --- SNMP control plane (printer persona + host monitoring) -----------------
# v1/v2c communities that may read the printer persona (space-separated).
# P-touch Editor for Mac uses "internal"; Windows tools and BRAdmin use
# "public". They are read-only and see ONLY the printer persona (SNMP context
# "printer"), never this host's own data.
SNMP_PRINTER_COMMUNITIES="public internal"
# Deprecated single-community form of the setting above; if set, it is added
# to SNMP_PRINTER_COMMUNITIES.
SNMP_PRINTER_COMMUNITY=""
# Sources allowed to query the persona on UDP/161 (space-separated CIDRs,
# IPv4 and/or IPv6): your clients' networks. This host itself (127.0.0.1) is
# always allowed, for selftest. Also the default for MDNS_ALLOWED_CIDRS.
# setup.sh sets it (--clients, or the network of the default route). The
# template's 192.0.2.0/24 is a documentation-only example that no real client
# uses: while no real client range is set, the installer warns and selftest.sh
# does not report T2/T3.
SNMP_PRINTER_ALLOWED_CIDRS="192.0.2.0/24"
# How the persona is served: "agentx" (full persona in its own SNMP context;
# recommended) or "pass_persist" (degraded fallback: only the Brother and
# Printer-MIB subtrees, no system/interface/host-resources identity).
SNMP_AGENT_MODE="agentx"
# SNMPv3 authPriv access to this host's own MIBs (and to the persona with
# "-n printer"), for a network monitoring system. auto = enabled only when both
# passphrases below are set (no longer the CHANGE-ME placeholders); yes = must
# be configured; no = disabled. Passphrases need at least 8 characters.
SNMP_V3_ENABLE="auto"
SNMP_V3_USER="nms"
SNMP_V3_AUTH_PROTO="SHA-256"    # SHA | SHA-224 | SHA-256 | SHA-384 | SHA-512
SNMP_V3_AUTH_PASS="CHANGE-ME-auth-passphrase"
SNMP_V3_PRIV_PROTO="AES"        # AES (= AES-128). DES is not available on Fedora.
SNMP_V3_PRIV_PASS="CHANGE-ME-priv-passphrase"
# Sources of the monitoring system (space-separated CIDRs; the template's
# 192.0.2.50/32 is a documentation-only example). SNMPv3 users cannot be
# limited by source inside net-snmp, so this is enforced by the firewall.
SNMP_V3_ALLOWED_CIDRS="192.0.2.50/32"

# --- Printer persona (what network clients see) --------------------------------
# Suffix of the Bonjour name "Brother QL-810W [<suffix>]". Empty = this host's
# short host name. The "Brother QL-810W" part is fixed: P-touch Editor for Mac
# derives the printer model from it.
PRINTER_NAME_SUFFIX=""
# Deprecated and ignored: replaced by PRINTER_NAME_SUFFIX.
PRINTER_DISPLAY_NAME=""
# Where the printer is (e.g. "Front office"): SNMP sysLocation and the Bonjour
# "note". Visible to anyone on the network; avoid personal data.
PERSONA_LOCATION=""
# Who to contact about the printer (SNMP sysContact). Visible in cleartext to
# SNMP clients; prefer a role over a person's name.
PERSONA_CONTACT=""
# Serial number the persona reports to SNMP clients (v1/v2c, cleartext, so
# readable by anyone in SNMP_PRINTER_ALLOWED_CIDRS). Empty = the printer's own
# USB serial number, as the real printer reports it.
PERSONA_SERIAL=""
# MAC address shown as the printer's (ifPhysAddress.1, the "BRW..." node name),
# six colon-separated hex pairs such as 00:00:5E:00:53:01. Empty = the MAC of
# the interface holding PROXY_IP.
PERSONA_MAC=""
# SNMP sysName of the persona. Empty = "BRW" + the persona MAC as 12 hex
# digits, like a real Brother Wi-Fi printer.
PERSONA_SYSNAME=""

# --- Logging -----------------------------------------------------------------
# Log level of ql810wc-proxyd and the SNMP agent in the journal: DEBUG, INFO,
# WARNING or ERROR (empty = INFO).
LOG_LEVEL="INFO"

# --- Discovery ---------------------------------------------------------------
# Publish a Bonjour/mDNS record so P-touch Editor for Mac and mobile apps find
# the printer (yes|no).
ENABLE_MDNS="yes"
# Sources allowed to send mDNS queries to this box (UDP 5353), space-separated
# CIDRs. Empty = SNMP_PRINTER_ALLOWED_CIDRS. The zone-wide "mdns" firewall
# service is never opened. IPv6 mDNS queries come from link-local addresses:
# add fe80::/10 if your clients use IPv6 only.
MDNS_ALLOWED_CIDRS=""
