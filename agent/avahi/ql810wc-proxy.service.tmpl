<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  /etc/avahi/services/ql810wc-proxy.service — generated by ql810wc-print-proxy
  (scripts/40-discovery.sh) from config.env; removed by uninstall.sh or when
  ENABLE_MDNS="no". Do not edit: re-run the installer instead.

  Bonjour/DNS-SD record that lets P-touch Editor for Mac and the Brother mobile
  apps find this box as a networked Brother QL-810W. P-touch accepts the
  service only if TXT "usb_MDL" is exactly "QL-810W" and TXT "UUID" exists, and
  it derives the model from the instance name ("Brother QL-810W [...]"), so
  both stay fixed. The other TXT keys mirror what real Brother printers publish.
-->
<service-group>
  <name replace-wildcards="no">@INSTANCE_NAME@</name>
  <service protocol="any">
    <type>_pdl-datastream._tcp</type>
    <port>@RAW_PORT@</port>
    <txt-record>txtvers=1</txt-record>
    <txt-record>qtotal=1</txt-record>
    <txt-record>pdl=application/octet-stream</txt-record>
    <txt-record>ty=Brother QL-810W</txt-record>
    <txt-record>product=(Brother QL-810W)</txt-record>
    <txt-record>usb_MFG=Brother</txt-record>
    <txt-record>usb_MDL=QL-810W</txt-record>
    <txt-record>priority=75</txt-record>
    <txt-record>UUID=@PRINTER_UUID@</txt-record>
    <txt-record>note=@NOTE@</txt-record>
  </service>
</service-group>
