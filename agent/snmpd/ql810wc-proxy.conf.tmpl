# /etc/snmp/snmpd.conf.d/ql810wc-proxy.conf
# Generated by ql810wc-print-proxy (scripts/30-snmp-agent.sh) from config.env;
# removed by uninstall.sh. Do not edit: change config.env and re-run
# ./install.sh (or ./install.sh --only 30). Mode 0600: it names communities.
# Included from /etc/snmp/snmpd.conf ("includeDir /etc/snmp/snmpd.conf.d").
#
# net-snmp treats "#" as a comment only at the start of a line, so no
# directive below carries a trailing comment.

# --- Listening address -----------------------------------------------------------
# SNMP broadcast discovery (Brother driver installer, BRAdmin) only reaches a
# wildcard UDP 161 socket. Who gets an answer is decided by the com2sec
# sources below and by the firewalld rules for UDP 161.
@AGENT_ADDRESS@

# --- How the printer persona is served (SNMP_AGENT_MODE="@AGENT_MODE@") ------------
@PERSONA_TRANSPORT@

# --- Printer persona: SNMPv1/v2c, read-only, source-scoped -------------------------
# The communities in SNMP_PRINTER_COMMUNITIES are accepted only from
# SNMP_PRINTER_ALLOWED_CIDRS (plus loopback, for selftest), can never write,
# and see only printerView:
@PERSONA_SCOPE@
# The first com2sec line that matches a request wins, so the installer refuses
# to run while another snmpd config file maps one of these communities.
@PRINTER_VIEW_LINES@
@COM2SEC@
group  @SEC_NAME@ v1  @SEC_NAME@
group  @SEC_NAME@ v2c @SEC_NAME@
@PERSONA_ACCESS@

# --- Host monitoring: SNMPv3 (USM, authPriv) only ----------------------------------
@HOST_ACCESS@
